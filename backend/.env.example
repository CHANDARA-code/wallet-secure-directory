NODE_ENV=development
PORT=3000
DATABASE_PATH=./data/wallet.db
BETTER_AUTH_SECRET=replace-with-output-of-openssl-rand-base64-32-or-longer
BETTER_AUTH_URL=http://localhost:3000
TRUSTED_ORIGINS=http://localhost:5173,http://localhost:3333
# TRUST_PROXY_HOPS: number of reverse proxy hops in front of the application.
# 0 = directly exposed / local development (no reverse proxy).
# 1 = behind one reverse proxy (e.g., Nginx, Cloudflare, AWS ALB).
# In production (NODE_ENV=production), TRUST_PROXY_HOPS must be set explicitly.
# Consequence: if set to 0 behind a reverse proxy, rate limiting keys on the proxy socket IP
# rather than client IPs, collapsing all users into one bucket and causing collective lockouts.
TRUST_PROXY_HOPS=0

# Apple Wallet Pass Signing Configuration (all required together for signed pass mode; omit for stub mode)
# APPLE_PASS_TYPE_ID=pass.com.example.wallet
# APPLE_TEAM_ID=TEAMID1234
# APPLE_PASS_CERT_PATH=./certs/apple-pass-cert.pem
# APPLE_PASS_KEY_PATH=./certs/apple-pass-key.pem
# APPLE_WWDR_CERT_PATH=./certs/apple-wwdr.pem
# APPLE_PASS_KEY_PASSPHRASE=optional-passphrase
# APPLE_PASS_ORGANIZATION=Secure Identity Wallet

# Google Wallet Pass Signing Configuration (all required together for signed pass mode; omit for stub mode)
# GOOGLE_WALLET_ISSUER_ID=1234567890123456789
# GOOGLE_WALLET_SERVICE_ACCOUNT_EMAIL=wallet-service-account@project.iam.gserviceaccount.com
# GOOGLE_WALLET_PRIVATE_KEY_PATH=./certs/google-wallet-private-key.pem
# GOOGLE_WALLET_CLASS_SUFFIX=identity_wallet
# GOOGLE_WALLET_ORIGINS=https://wallet.example.com
